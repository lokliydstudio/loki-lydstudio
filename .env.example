# Mailbox and sender settings (store real values only in Vercel)
MAIL_ADDRESS=post@lokilyd.no
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.domeneshop.no
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.domeneshop.no
MAIL_SMTP_PORT=587

# Transactional sender on Vercel (Domeneshop remains the IMAP inbox)
RESEND_API_KEY=

# Passwordless CRM access
CRM_ALLOWED_EMAILS=leon@lokilyd.no,charles@lokilyd.no
CRM_AUTH_SECRET=
CRM_BASE_URL=https://www.lokilyd.no

# Private Vercel Blob store and read-only local Jottacloud metadata bridge
BLOB_STORE_ID=
JOTTA_BRIDGE_SECRET=
CRON_SECRET=
JOTTA_ROOT=/Users/your-user/Jottacloud/Loki Lydstudio/Dokumenter (Cloud)
CRM_DOCUMENTS_ENDPOINT=https://www.lokilyd.no/api/crm/documents
JOTTA_AUDIO_ROOT=/Users/your-user/Jottacloud/Loki Lydstudio/Dokumenter (Cloud)/CRM lydfiler
CRM_AUDIO_SYNC_ENDPOINT=https://www.lokilyd.no/api/studio?action=jotta-sync

# AI Gateway is disabled until usage is explicitly approved
AI_DRAFTS_ENABLED=false
AI_DRAFT_MODEL=openai/gpt-5.4
